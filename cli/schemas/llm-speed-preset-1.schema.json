{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-speed.com/schemas/llm-speed-preset-1.schema.json",
  "title": "llm-speed-preset/1",
  "$comment": "Single schema shared by the Worker (POST /v1/presets/publish) and the CLI (llm-speed agent / bench --preset). Data only: every object is closed (additionalProperties false), so no command, cmd, exec, script or url field can exist. Keywords used are limited to: type, const, enum, pattern, minLength, maxLength, minimum, maximum, items, minItems, maxItems, uniqueItems, minProperties, properties, required, additionalProperties, patternProperties, propertyNames, anyOf, $ref (#/$defs/...). Patterns use the common subset of ECMAScript and Python re. Environment variables are limited to an allowlist (env.LLM_SPEED_DECAY_CTX, digits only). Keys starting with _ are free-text notes. Version-only-goes-up and cross-references (profile entries -> models) are checked by the publisher in code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "preset",
    "version",
    "title",
    "contexts",
    "models",
    "profiles"
  ],
  "properties": {
    "schema": {
      "const": "llm-speed-preset/1"
    },
    "preset": {
      "$ref": "#/$defs/slug"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "launch": {
      "$ref": "#/$defs/slug"
    },
    "min_llama_build": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "min_llama_build_why": {
      "$ref": "#/$defs/text"
    },
    "contexts": {
      "$ref": "#/$defs/contexts"
    },
    "workloads_by_ctx": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9]{1,7}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(chat-short|chat-long|long-context-decay)(,(chat-short|chat-long|long-context-decay)){0,2}$"
      }
    },
    "server_args": {
      "$ref": "#/$defs/llama_args"
    },
    "mlx_args": {
      "$ref": "#/$defs/mlx_args"
    },
    "sampling": {
      "$ref": "#/$defs/sampling"
    },
    "health_timeout_s": {
      "type": "integer",
      "minimum": 10,
      "maximum": 3600
    },
    "bench_timeout_s": {
      "type": "integer",
      "minimum": 60,
      "maximum": 14400
    },
    "disk_margin_gb": {
      "type": "number",
      "minimum": 0,
      "maximum": 200
    },
    "memory_headroom_mib": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nvidia": {
          "$ref": "#/$defs/mib"
        },
        "apple": {
          "$ref": "#/$defs/mib"
        },
        "amd": {
          "$ref": "#/$defs/mib"
        },
        "cpu": {
          "$ref": "#/$defs/mib"
        }
      }
    },
    "apple_gpu_memory_fraction": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/entry_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "nvidia",
          "apple",
          "amd",
          "cpu"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,80}$"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    },
    "mib": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "ctx": {
      "type": "integer",
      "minimum": 512,
      "maximum": 1048576
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ctx"
      }
    },
    "llama_args": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "pattern": "^(--parallel|-np|--no-cache-prompt|--cache-ram|--temp|--seed|--top-k|--top-p|--min-p|-ngl|--n-gpu-layers|--n-cpu-moe|-fa|--flash-attn|--cache-type-k|--cache-type-v|-ctk|-ctv|-b|--batch-size|-ub|--ubatch-size|-t|--threads|--no-mmap|--mlock|--jinja|--reasoning-budget|--reasoning-format|--swa-full|--no-warmup|--kv-unified|--split-mode|-sm|-?[0-9]{1,7}(\\.[0-9]{1,4})?|on|off|auto|none|deepseek|layer|row|f16|bf16|f32|q8_0|q4_0|q4_1|q5_0|q5_1|iq4_nl)$"
      }
    },
    "mlx_args": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^(--max-kv-size|--temp|--seed|--top-p|--max-tokens|--kv-bits|--kv-group-size|--quantized-kv-start|-?[0-9]{1,7}(\\.[0-9]{1,4})?)$"
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "top_k": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "backend",
        "quant",
        "repo",
        "revision",
        "bytes"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/slug"
        },
        "backend": {
          "enum": [
            "llama.cpp",
            "mlx"
          ]
        },
        "quant": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,40}$"
        },
        "repo": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^(RecursiveSI|unsloth|ggml-org|bartowski|mlx-community|lmstudio-community|Qwen|meta-llama|mistralai|google|microsoft|deepseek-ai|nvidia|openai|ibm-granite|allenai|THUDM|zai-org|moonshotai|MiniMaxAI|LiquidAI|HuggingFaceTB)/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,150}\\.gguf$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,150}\\.gguf$"
          }
        },
        "dir": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,100}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 137438953472
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requires_gpu_regex": {
          "type": "string",
          "maxLength": 200
        },
        "requires_gpu_why": {
          "$ref": "#/$defs/text"
        },
        "min_ram_gb": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096
        },
        "contexts": {
          "$ref": "#/$defs/ctx_steps"
        },
        "reasoning": {
          "enum": [
            "on",
            "off",
            "auto"
          ]
        },
        "control": {
          "type": "boolean"
        },
        "server_args": {
          "$ref": "#/$defs/llama_args"
        },
        "mlx_args": {
          "$ref": "#/$defs/mlx_args"
        },
        "sampling": {
          "$ref": "#/$defs/sampling"
        },
        "min_free_disk_gb": {
          "type": "number",
          "minimum": 0,
          "maximum": 4096
        }
      },
      "patternProperties": {
        "^_[a-z_]{1,30}$": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entry_id"
          }
        },
        "fallback": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entry_id"
          }
        },
        "control": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entry_id"
          }
        },
        "offload_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry"
          ],
          "properties": {
            "entry": {
              "$ref": "#/$defs/entry_id"
            },
            "n_cpu_moe": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "contexts": {
              "$ref": "#/$defs/contexts"
            }
          }
        },
        "contexts": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/entry_id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ctx_steps"
          }
        }
      },
      "patternProperties": {
        "^_[a-z_]{1,30}$": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "ctx_step": {
      "anyOf": [
        {
          "$ref": "#/$defs/ctx"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ctx"
          ],
          "properties": {
            "ctx": {
              "$ref": "#/$defs/ctx"
            },
            "workloads": {
              "type": "string",
              "pattern": "^(chat-short|chat-long|long-context-decay)(,(chat-short|chat-long|long-context-decay)){0,2}$"
            },
            "min_ram_gb": {
              "type": "number",
              "minimum": 0,
              "maximum": 4096
            },
            "env": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "LLM_SPEED_DECAY_CTX": {
                  "type": "string",
                  "pattern": "^[0-9]{3,7}$"
                }
              }
            }
          }
        }
      ]
    },
    "ctx_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/ctx_step"
      }
    }
  },
  "patternProperties": {
    "^_[a-z_]{1,30}$": {
      "$ref": "#/$defs/note"
    }
  }
}
